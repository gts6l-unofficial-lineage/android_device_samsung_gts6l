cc_library_shared {
    name: "libspeakereq.gts6l",
    relative_install_path: "soundfx",
    vendor: true,
    compile_multilib: "both",
    srcs: ["SpeakerEq.c"],
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-O2",
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
    ],
}
